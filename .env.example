# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Leave any value empty to keep that feature in Demo Mode.
# These are browser-visible keys by design: restrict them (see README).

# Google Maps JavaScript API + Places API (New)
GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers (Google Cloud → Map Management). Optional; DEMO_MAP_ID is used if empty.
GOOGLE_MAPS_MAP_ID=

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# true = ignore all keys and run the demo
FORCE_DEMO=false
